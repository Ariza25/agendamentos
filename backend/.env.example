# ==============================================================================
# ERP Agendamentos - Variáveis de Ambiente
# ==============================================================================

# Porta do Servidor
PORT=8080

# Banco de Dados PostgreSQL
DATABASE_URL=postgres://erp:erp@localhost:5432/erpagendamentos?sslmode=disable

# Chave Secreta para JWT (mínimo 32 caracteres)
JWT_SECRET=sua-chave-secreta-jwt-com-pelo-menos-32-caracteres

# URL Base do Painel Administrativo
ADMIN_BASE_URL=https://ariza25.github.io/agendamentos/admin

# ==============================================================================
# Autenticação Google OAuth 2.0 (Login e Criação de Conta com Google)
# Obtenha suas credenciais no Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
#
# Em "URIs de redirecionamento autorizados", adicione:
# https://erpagendamentos-backend-88726602471.southamerica-east1.run.app/api/v1/auth/google/callback
# http://localhost:8080/api/v1/auth/google/callback
# ==============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

